# =============================================================================
# terraform/terraform.tfvars.example
# =============================================================================
#
# STEP 1 — Copy this file to terraform.tfvars and fill in your values.
#   WHY: terraform.tfvars is gitignored so your account ID never ends up in
#        source control. This example file serves as documentation for what
#        values are required and is safe to commit.
#
#   Command:
#     cp terraform/terraform.tfvars.example terraform/terraform.tfvars
#     # Then edit terraform.tfvars with your real values
#
# =============================================================================

environment = "dev"
aws_region  = "us-east-1"
account_id  = "123456789012"   # replace with your real AWS account ID

# Optional — override defaults if needed:
# kms_deletion_window_days   = 7
# s3_glacier_transition_days = 90
# s3_expiration_days         = 365
# processed_expiration_days  = 90
